{
    "name": "tangible/ddd-wp",
    "description": "WordPress adapter for tangible/ddd-core: wpdb stores, Action Scheduler relay, hook facades, admin dashboard and WP-CLI. WordPress plugins require tangible/ddd, not this package.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tangible",
            "email": "dev@tangible.one"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ddd-core",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "tangible/ddd-core": "self.version",
        "woocommerce/action-scheduler": "^3.9",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4",
        "symfony/yaml": "^7.4",
        "makinacorpus/query-builder": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "TangibleDDD\\": "src/",
            "TangibleDDD\\WordPress\\": "wordpress/"
        }
    }
}
