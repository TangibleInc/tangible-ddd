{
    "name": "tangible/ddd-conformance",
    "description": "Dev-only, host-agnostic conformance scenarios for tangible/ddd-core hosts (mem, pdo, wp, sf). Each host implements HostFixture and extends the abstract scenario cases.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tangible",
            "email": "dev@tangible.one"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ddd-core",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpunit/phpunit": "^11.0",
        "tangible/ddd-core": "self.version",
        "league/tactician": "^2.0-rc1",
        "psr/log": "^2|^3"
    },
    "autoload": {
        "psr-4": {
            "TangibleDDD\\Conformance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TangibleDDD\\Conformance\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
