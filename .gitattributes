/tools                      export-ignore
/docs                       export-ignore
/examples                   export-ignore
/packages/ddd-symfony       export-ignore
/packages/ddd-conformance   export-ignore
/packages/*/tests           export-ignore

/.github                    export-ignore
/.claude                    export-ignore
/phpunit.xml                export-ignore
/phpunit.integration.xml    export-ignore
/phpstan*.neon              export-ignore
/deptrac.yaml               export-ignore
/.gitattributes             export-ignore
/.gitignore                 export-ignore
/with-love-from-codex-for-opus.md export-ignore
